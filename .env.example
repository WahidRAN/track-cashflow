# ===========================
# Track Cashflow — Environment Variables
# Copy this file to .env and fill in your values
# ===========================

# Supabase Project Settings
# Get from: https://app.supabase.com → Project Settings → API
NUXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role Key (server-only, never expose to client)
# Get from: Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase Database Connection
# Get from: Project Settings → Database → Connection string
# Use port 5432 (not 6543) for direct connection
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI API Key (for product embedding/price comparison)
# Get from: https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=pa-...
