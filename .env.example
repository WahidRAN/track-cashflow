# ===========================
# Track Cashflow — environment variables
# cp .env.example .env   (then restart `npm run dev` after any change)
# ===========================

# ---------------------------
# Supabase — Local (npm run db:start)
# Values below are the fixed demo defaults of the Supabase CLI local stack; confirm them with
#   npm run db:status -- -o env
# `supabase status` name      ->  env var here
#   API_URL                   ->  NUXT_PUBLIC_SUPABASE_URL
#   ANON_KEY                  ->  NUXT_PUBLIC_SUPABASE_KEY      (PUBLISHABLE_KEY works too)
#   SERVICE_ROLE_KEY          ->  SUPABASE_SERVICE_ROLE_KEY     (SECRET_KEY works too)
#   DB_URL                    ->  DATABASE_URL
#   MAILPIT_URL               ->  (open in a browser to click magic links)
# These demo keys are public knowledge — never use them for a hosted project.
# ---------------------------
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public (browser) key, protected by RLS
NUXT_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server-only admin key (bypasses RLS) — used for the private `receipts` storage bucket
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Server-only direct Postgres connection (Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------
# Supabase — Hosted (supabase.com) — uncomment and replace the Local block above
# Dashboard → Project Settings → API Keys / Data API / Database → Connect
# ---------------------------
# NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...          # or the legacy "anon" key
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...              # or the legacy "service_role" key
# Session pooler (IPv4-friendly, works on Vercel), or the direct connection on port 5432
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Hosted setup: apply supabase/migrations/*.sql (`npx -y supabase@2.107.0 link` + `db push`, or the
# SQL editor), create a PRIVATE storage bucket named `receipts`, and set Auth → URL Configuration
# (Site URL + redirect URL https://<your-domain>/auth/confirm).

# ===========================
# AI provider (receipt extraction) — server-only
# ===========================

# Which backend extracts receipt data: claude (default) | ollama
AI_PROVIDER=claude

# Required only when AI_PROVIDER=claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-5

# Used only when AI_PROVIDER=ollama (Ollama running on Windows, see docs/local-ai-setup.md)
# With WSL2 mirrored networking localhost works; otherwise use the Windows host IP
OLLAMA_BASE_URL=http://localhost:11434
# Lighter fallback for 6 GB GPUs: qwen2.5vl:3b
OLLAMA_MODEL=qwen2.5vl:7b

# ===========================
# Display (public, sent to the browser)
# ===========================

# ISO 4217 currency code used for formatting amounts
NUXT_PUBLIC_CURRENCY=JPY
# BCP 47 locale for number/date formatting
NUXT_PUBLIC_LOCALE=en-US
# IANA timezone used for receipt times printed without an offset
NUXT_PUBLIC_TIMEZONE=Asia/Tokyo
