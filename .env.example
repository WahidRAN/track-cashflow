# ===========================
# Track Cashflow — Environment Variables
# Copy this file to .env and fill in your values
# ===========================

# Supabase Project Settings
# Get from: https://app.supabase.com → Project Settings → API
NUXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role Key (server-only, never expose to client)
# Get from: Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase Database Connection
# Get from: Project Settings → Database → Connection string
# Use port 5432 (not 6543) for direct connection
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# ===========================
# AI provider (receipt extraction) — server-only
# See docs/local-ai-setup.md for running Ollama locally
# ===========================

# Which backend extracts receipt data: claude (default) | ollama
AI_PROVIDER=claude

# Claude model used when AI_PROVIDER=claude
CLAUDE_MODEL=claude-opus-4-5

# Ollama server URL used when AI_PROVIDER=ollama
# From WSL2 with mirrored networking, localhost works; otherwise use the Windows host IP
OLLAMA_BASE_URL=http://localhost:11434

# Ollama vision model used when AI_PROVIDER=ollama (lighter fallback: qwen2.5vl:3b)
OLLAMA_MODEL=qwen2.5vl:7b

# Anthropic Claude API Key (required only when AI_PROVIDER=claude)
# Get from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI API Key (optional — for product embedding/price comparison)
# Leave empty to skip embeddings; price indicators will then be unavailable
# Get from: https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=pa-...
